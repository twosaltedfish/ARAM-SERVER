# ===== aramgg 数据源（必填）=====
# 第三方 API Key（Bearer 鉴权）。仅存于服务器，切勿写入小程序前端。
# 支持配置多个 Key 以叠加每日额度并自动负载均衡：用英文逗号分隔。
# 例如 2 个 Key → 每日额度 400 credits，可全量同步 173 英雄详情(约 349)。
# 单 Key 仍兼容：只填 DTODO_API_KEY 即可。
DTODO_API_KEYS=your_api_key_1,your_api_key_2
# DTODO_API_KEY=your_api_key_here

# ===== 服务配置 =====
# 监听端口（Nginx 反代到此端口）
PORT=3000

# SQLite 文件路径（相对 server.js 启动目录；可改绝对路径）
DB_PATH=./data/aram.db

# 是否拉取每个英雄的详情（champions/{id}.json）。
# 开(true)则每日全量约 349 credits（173 英雄×2 + 基础榜单 3）；
# 配 2 个 Key(400/天)足够，单 Key(200/天)不够需改为按需懒加载或只拉前 N 名。
# 关(false)则只拉榜单/强化/装备，约 3 credits，详情改为按需懒加载。
FETCH_DETAILS=true

# 海克斯强化库 / 装备库 / 它们的详情：默认开启。
# 仅在「榜单/详情未变化」的安静日（或 FORCE=true）才拉取，各 1 credit/天（详情文件各 1 credit）。
# 若想关闭，显式设为 false 即可（一般不推荐）。
FETCH_AUGMENTS=true
FETCH_ITEMS=true

# 小程序实际请求的接口域名（仅作记录，真实配置在小程序端 request 合法域名）
API_BASE=https://api.yourdomain.cn
